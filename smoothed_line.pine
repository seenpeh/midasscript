//@version=5
indicator("Smoothed Price Line", overlay=true)

// ─── Inputs ───────────────────────────────────────────────
src        = input.source(close,                       "Source")
smoothing  = input.int(10,  "Smoothness",     minval=1, maxval=200,
                            tooltip="Higher = smoother but more lag")
method     = input.string("ALMA", "Smoothing Method",
                            options=["ALMA", "EMA", "SMA", "WMA", "Linear Regression", "Double EMA"])

// ALMA fine-tuning (only used when method = ALMA)
almaOffset = input.float(0.85, "ALMA Offset", minval=0.0, maxval=1.0, group="ALMA")
almaSigma  = input.float(6.0,  "ALMA Sigma",  minval=0.1,            group="ALMA")

// ─── Smoothing ────────────────────────────────────────────
dema(s, len) =>
    e1 = ta.ema(s, len)
    e2 = ta.ema(e1, len)
    2 * e1 - e2

smoothed = switch method
    "ALMA"              => ta.alma(src, smoothing, almaOffset, almaSigma)
    "EMA"               => ta.ema(src, smoothing)
    "SMA"               => ta.sma(src, smoothing)
    "WMA"               => ta.wma(src, smoothing)
    "Linear Regression" => ta.linreg(src, smoothing, 0)
    "Double EMA"        => dema(src, smoothing)
    => src

// ─── Plot ─────────────────────────────────────────────────
// Color the line by slope direction
lineColor = smoothed > smoothed[1] ? color.new(color.teal, 0) : color.new(color.red, 0)

plot(smoothed, "Smoothed Line", color=lineColor, linewidth=2)
